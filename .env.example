# ============================================================
# BOLIVAR COFFEE & LOUNGE — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

NODE_ENV=development

PORT=3000

# Supabase (from Settings → API in your Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — generate a strong random string for production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-secret

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:3000
