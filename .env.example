# ============================================================
# BOLIVAR COFFEE & LOUNGE — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# Supabase Project URL (from your Supabase dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (safe for browser — used on the frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SECRET — only for setup scripts, never in frontend code!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# HOW TO GET THESE VALUES:
# 1. Go to https://supabase.com and create a new project
# 2. Go to Settings → API
# 3. Copy the "Project URL" and "anon / public" key
# 4. Copy the "service_role" key (keep this secret!)
# ============================================================
